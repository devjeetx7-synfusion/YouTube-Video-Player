<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.cineflow.player.fragments.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_addVideo"
            app:destination="@id/addVideoFragment" />
        <action
            android:id="@+id/action_home_to_videoPlayer"
            app:destination="@id/videoPlayerFragment" />
    </fragment>

    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.cineflow.player.fragments.LibraryFragment"
        android:label="Library"
        tools:layout="@layout/fragment_library">
        <action
            android:id="@+id/action_library_to_videoPlayer"
            app:destination="@id/videoPlayerFragment" />
    </fragment>

    <fragment
        android:id="@+id/playlistsFragment"
        android:name="com.cineflow.player.fragments.PlaylistsFragment"
        android:label="Playlists"
        tools:layout="@layout/fragment_playlists">
        <action
            android:id="@+id/action_playlists_to_videoPlayer"
            app:destination="@id/videoPlayerFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.cineflow.player.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/addVideoFragment"
        android:name="com.cineflow.player.fragments.AddVideoFragment"
        android:label="Add Video"
        tools:layout="@layout/fragment_add_video">
        <action
            android:id="@+id/action_addVideo_to_videoPlayer"
            app:destination="@id/videoPlayerFragment"
            app:popUpTo="@id/addVideoFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/videoPlayerFragment"
        android:name="com.cineflow.player.fragments.VideoPlayerFragment"
        android:label="Video Player"
        tools:layout="@layout/fragment_player">
        <argument
            android:name="videoUrl"
            app:argType="string" />
    </fragment>

</navigation>
